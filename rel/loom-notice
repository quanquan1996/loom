#!/usr/bin/env python3
"""loom-notice: post to the user's bell in Loom, from a Loom session.

  loom-notice post --priority N [--key KEY] [--needs read|reply|approve] SUMMARY
  loom-notice withdraw KEY
  loom-notice list

The session is LOOM_SESSION_ID, which Loom sets for every session it starts;
the address and key are in LOOM_CLI (default ~/.loom/node-cli.json), as for
loom-node. See the loom-notify skill for how to choose a priority.
"""
import argparse, json, os, sys, urllib.error, urllib.request


def endpoint():
    path = os.environ.get("LOOM_CLI") or os.path.join(
        os.environ.get("LOOM_HOME") or os.path.expanduser("~/.loom"), "node-cli.json")
    try:
        with open(path) as f:
            e = json.load(f)
    except OSError as err:
        sys.exit(f"loom-notice: cannot read {path} (is Loom running on this host?): {err}")
    return e["url"].rstrip("/"), e["key"]


def call(method, route, body=None):
    session = os.environ.get("LOOM_SESSION_ID")
    if not session:
        sys.exit("loom-notice: LOOM_SESSION_ID is not set; run this from a session Loom started")
    url, key = endpoint()
    req = urllib.request.Request(
        f"{url}/api/notice/{route}", method=method,
        data=json.dumps(body).encode() if body is not None else None,
        headers={"x-loom-key": key, "x-loom-session": session, "content-type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.load(r)
    except urllib.error.HTTPError as err:
        try:
            msg = json.load(err).get("error")
        except Exception:
            msg = err.reason
        sys.exit(f"loom-notice: {msg}")
    except urllib.error.URLError as err:
        sys.exit(f"loom-notice: cannot reach Loom at {url}: {err.reason}")


def show(n):
    note = f"  ({n['note']})" if n.get("note") else ""
    print(f"[{n.get('key') or '-'}] P{n['priority']} {n['needs']} {n['status']}: {n['summary']}{note}")


def main():
    p = argparse.ArgumentParser(prog="loom-notice", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    post = sub.add_parser("post", help="post a notice, or update the open one with the same key")
    post.add_argument("--priority", "-p", type=int, required=True, help="0 most urgent … 10")
    post.add_argument("--key", "-k", help="to update or withdraw it later")
    post.add_argument("--needs", choices=["read", "reply", "approve"])
    post.add_argument("summary", nargs="+")
    w = sub.add_parser("withdraw", help="take back your open notice with KEY")
    w.add_argument("key")
    sub.add_parser("list", help="your notices still open")
    a = p.parse_args()

    if a.cmd == "post":
        body = {"summary": " ".join(a.summary), "priority": a.priority}
        if a.key: body["key"] = a.key
        if a.needs: body["needs"] = a.needs
        show(call("POST", "post", body)["notice"])
    elif a.cmd == "withdraw":
        call("POST", "withdraw", {"key": a.key})
        print(f"withdrawn: {a.key}")
    else:
        notices = call("GET", "mine")["notices"]
        if not notices:
            print("none open")
        for n in notices:
            show(n)


if __name__ == "__main__":
    main()
